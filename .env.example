# Copie para .env: `cp .env.example .env`
# O .env não é versionado. Os valores abaixo são de DESENVOLVIMENTO.

# --- banco -------------------------------------------------------------
POSTGRES_USER=mdbd
POSTGRES_PASSWORD=mdbd
POSTGRES_DB=mediabuild

# Alternativa às partes acima: uma URL inteira, que tem precedência.
# É o formato que um Postgres gerenciado costuma entregar.
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/mediabuild

# Rodando o backend FORA do Docker, o hostname `db` não resolve:
# DATABASE_URL=postgresql+psycopg://mdbd:mdbd@localhost:5432/mediabuild

# --- portas expostas no host -------------------------------------------
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=5173

# --- aplicação ----------------------------------------------------------
# DEBUG=false liga a checagem que RECUSA subir com os valores de exemplo
# acima. É o que impede levar a senha `mdbd` para um ambiente real.
DEBUG=true

# Fuso em que o analista pensa, para os filtros de data do histórico.
# NÃO é o fuso do servidor: `criado_em` é gravado em UTC, e na nuvem o
# servidor provavelmente estará em UTC. Sem isto, entre 21h e meia-noite
# locais o filtro `ate=<hoje>` esconderia o que acabou de ser gerado.
FUSO_HORARIO=America/Sao_Paulo

# Origens do frontend. Lista JSON ou separada por vírgula.
CORS_ORIGINS=http://localhost:5173

# --- autenticação (D-014) ------------------------------------------------
# Duração da sessão opaca, em horas.
SESSAO_DURACAO_HORAS=12

# Primeiro administrador, criado pelo `python -m app.seed`. A identidade de
# login é um **login**, não um e-mail: o produto não manda e-mail e não tem
# recuperação de senha por link.
#
# A senha real NÃO fica aqui — este arquivo é versionado. Escreva-a no .env,
# que é local. Com DEBUG=false, subir com o placeholder abaixo derruba a
# aplicação no boot, de propósito.
ADMIN_LOGIN_INICIAL=admin.mediabuilder
ADMIN_SENHA_INICIAL=mudar-agora

# --- logging ------------------------------------------------------------
LOG_LEVEL=INFO
# Sem definir: JSON quando DEBUG=false, texto legível quando DEBUG=true.
# LOG_JSON=true
